# Operational Mode: live | mock
DATA_MODE=live

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_db_password_2026
DATABASE_URL=postgresql://postgres:replace_with_secure_db_password_2026@db:5432/economic_indicators
DB_MIN_SIZE=2
DB_MAX_SIZE=10

# Authentication & Security
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
STREAM_TICKET_EXPIRE_SECONDS=30

# Evaluation Analyst User
EVAL_USERNAME=analyst@adityabirla.com
EVAL_PASSWORD=ReplaceWithSecureAnalystPassword@2026!

# CORS & Frontend Origin
FRONTEND_ORIGIN=http://localhost:5173

# Development Guard Override (set to true only for local development)
ALLOW_INSECURE_DEFAULTS=false

# Frontend specific variables
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCKS=false
