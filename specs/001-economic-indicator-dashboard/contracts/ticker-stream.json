{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TickerStreamContracts",
  "type": "object",
  "required": ["timestamp", "quotes"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "currentPrice",
          "changePoints",
          "changePercent",
          "isPositive",
          "updatedAt",
          "source",
          "market_status"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "enum": ["NIFTY BANK", "NIFTY IT", "SENSEX"]
          },
          "name": { "type": "string" },
          "currentPrice": { "type": "number" },
          "changePoints": { "type": "number" },
          "changePercent": { "type": "number" },
          "isPositive": { "type": "boolean" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "source": { "type": "string" },
          "market_status": {
            "type": "string",
            "enum": ["open", "closed", "stale"]
          }
        }
      }
    }
  }
}
