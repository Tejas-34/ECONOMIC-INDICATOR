{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TickerSnapshotPayload",
  "type": "object",
  "required": ["timestamp", "quotes"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "name", "last", "change", "pct_change", "as_of", "source", "market_status"],
        "properties": {
          "symbol": { "type": "string", "enum": ["SENSEX", "NIFTY BANK", "NIFTY IT"] },
          "name": { "type": "string" },
          "last": { "type": "number" },
          "change": { "type": "number" },
          "pct_change": { "type": "number" },
          "as_of": { "type": "string", "format": "date-time" },
          "source": { "type": "string" },
          "market_status": {
            "type": "string",
            "enum": ["open", "closed", "stale"]
          }
        }
      }
    }
  }
}
