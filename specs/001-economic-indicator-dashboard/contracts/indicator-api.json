{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StandardIndicatorEnvelope",
  "type": "object",
  "required": ["indicator", "title", "tiles", "series", "source", "as_of", "fetched_at", "status"],
  "properties": {
    "indicator": {
      "type": "string",
      "enum": ["gdp-growth", "debt-to-gdp", "trade", "gst", "inflation", "government-expenditure"]
    },
    "title": { "type": "string" },
    "subtitle": { "type": ["string", "null"] },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value", "unit", "change", "change_unit"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": ["number", "null"] },
          "unit": { "type": ["string", "null"] },
          "change": { "type": ["number", "null"] },
          "change_unit": { "type": ["string", "null"] }
        }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "points"],
        "properties": {
          "name": { "type": "string" },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["period", "value"],
              "properties": {
                "period": { "type": "string" },
                "value": { "type": ["number", "null"] },
                "basis": {
                  "type": ["string", "null"],
                  "enum": ["actual", "revised_estimate", "budget_estimate", null]
                }
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "type", "url"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["nse", "external", "external-curated"]
        },
        "url": { "type": "string" }
      }
    },
    "as_of": { "type": "string" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["ok", "stale", "unavailable"]
    }
  }
}
