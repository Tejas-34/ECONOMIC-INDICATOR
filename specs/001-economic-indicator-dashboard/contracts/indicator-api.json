{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IndicatorResponse",
  "type": "object",
  "required": [
    "id",
    "title",
    "source",
    "source_type",
    "as_of",
    "status",
    "values",
    "series"
  ],
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "gdp-growth",
        "debt-to-gdp",
        "trade-balance",
        "gst-collection",
        "inflation",
        "govt-expenditure"
      ]
    },
    "title": { "type": "string" },
    "subtitle": { "type": ["string", "null"] },
    "source": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": ["NSE", "external"]
    },
    "as_of": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["ok", "stale", "unavailable"]
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/StatTileMetric"
      }
    },
    "series": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "definitions": {
    "StatTileMetric": {
      "type": "object",
      "required": ["label", "value", "deltaDirection"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": ["number", "string", "null"] },
        "formattedValue": { "type": "string" },
        "unit": { "type": ["string", "null"] },
        "delta": { "type": ["number", "null"] },
        "formattedDelta": { "type": ["string", "null"] },
        "deltaUnit": { "type": ["string", "null"] },
        "deltaDirection": {
          "type": "string",
          "enum": ["positive", "negative", "neutral"]
        },
        "sublabel": { "type": ["string", "null"] },
        "iconKey": { "type": ["string", "null"] }
      }
    }
  }
}
