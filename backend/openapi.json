          "currentPrice": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currentprice",
            "description": "Frontend alias for last."
          },
          "changePoints": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Changepoints",
            "description": "Frontend alias for change."
          },
          "changePercent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Changepercent",
            "description": "Frontend alias for pct_change."
          },
          "isPositive": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ispositive",
            "description": "Frontend boolean indicating positive delta."
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updatedat",
            "description": "Frontend alias for as_of."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "symbol",
          "last",
          "change",
          "pct_change",
          "as_of"
        ],
        "title": "MarketIndexQuote"
      },
      "SourceProvenance": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Authoritative publisher or agency name."
