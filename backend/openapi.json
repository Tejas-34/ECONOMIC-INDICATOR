{
  "openapi": "3.1.0",
  "info": {
    "title": "Economic Indicator Dashboard API",
    "description": "FastAPI backend serving macroeconomic indicators and live market index quotes.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "description": "Public healthcheck endpoint reporting service mode, db status, scheduler state, and job ages (I6).",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authenticate analyst and issue 60-minute JWT Bearer token",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginCredentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get authenticated analyst profile",
        "operationId": "get_me_api_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUser"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/auth/stream-ticket": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Acquire a single-use 30-second ticket for SSE ticker connection",
        "operationId": "acquire_stream_ticket_api_auth_stream_ticket_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamTicketResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Analyst sign-out cleanup",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/admin/refresh/{job}": {
      "post": {
        "tags": [
          "Admin Operations"
        ],
        "summary": "On-demand trigger for data collection jobs (admin only)",
        "description": "Admin-only on-demand data refresh route.",
        "operationId": "trigger_job_refresh_api_admin_refresh__job__post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "macro",
                "ticker",
                "seeds"
              ],
              "type": "string",
              "title": "Job"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Trigger Job Refresh Api Admin Refresh  Job  Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/indicators/{indicator_slug}": {
      "get": {
        "tags": [
          "Indicators"
        ],
        "summary": "Get individual macroeconomic indicator panel data",
        "operationId": "get_indicator_api_indicators__indicator_slug__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "indicator_slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Indicator Slug"
            }
          },
          {
            "name": "if-none-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardIndicatorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": [
          "Indicators"
        ],
        "summary": "Get consolidated dashboard with all six indicator panels",
        "operationId": "get_dashboard_api_dashboard_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "if-none-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ticker": {
      "get": {
        "tags": [
          "Ticker"
        ],
        "summary": "Get current market index quotes snapshot",
        "operationId": "get_ticker_snapshot_api_ticker_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TickerSnapshotPayload"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/stream/ticker": {
      "get": {
        "tags": [
          "Ticker"
        ],
        "summary": "Connect to Server-Sent Events (SSE) live ticker stream",
        "operationId": "stream_ticker_api_stream_ticker_get",
        "parameters": [
          {
            "name": "ticket",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Single-use stream ticket",
              "title": "Ticket"
            },
            "description": "Single-use stream ticket"
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthUser": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique user identifier."
          },
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Username."
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Email address."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Display name.",
            "default": "Lead Macro Analyst"
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "admin"
            ],
            "title": "Role",
            "description": "User role ('viewer' or 'admin').",
            "default": "viewer"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "title": "AuthUser"
      },
      "DashboardResponse": {
        "properties": {
          "indicators": {
            "items": {
              "$ref": "#/components/schemas/StandardIndicatorEnvelope"
            },
            "type": "array",
            "title": "Indicators",
            "description": "All indicator panels."
          },
          "as_of": {
            "type": "string",
            "title": "As Of",
            "description": "Effective dashboard as-of timestamp."
          },
          "fetched_at": {
            "type": "string",
            "title": "Fetched At",
            "description": "ISO 8601 fetch timestamp."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "indicators",
          "as_of",
          "fetched_at"
        ],
        "title": "DashboardResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginCredentials": {
        "properties": {
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username",
            "description": "Username or email."
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Email alias for username."
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Plaintext user password."
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "LoginCredentials"
      },
      "LoginResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUser",
            "description": "Authenticated user profile."
          },
          "accessToken": {
            "type": "string",
            "title": "Accesstoken",
            "description": "JWT Bearer access token."
          },
          "access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Token",
            "description": "OAuth2 alias for accessToken."
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "description": "Token category.",
            "default": "bearer"
          },
          "expiresInSeconds": {
            "type": "integer",
            "title": "Expiresinseconds",
            "description": "Token lifetime in seconds.",
            "default": 3600
