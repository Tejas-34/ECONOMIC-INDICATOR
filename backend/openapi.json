          "expires_in_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In Seconds",
            "description": "Alias for expiresInSeconds.",
            "default": 3600
          }
        },
        "type": "object",
        "required": [
          "user",
          "accessToken"
        ],
        "title": "LoginResponse"
      },
      "MarketIndexQuote": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "description": "Exchange symbol (e.g. SENSEX, NIFTY BANK, NIFTY IT)."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Human-readable index name."
          },
          "last": {
            "type": "number",
            "title": "Last",
            "description": "Last traded points value."
          },
          "change": {
            "type": "number",
            "title": "Change",
            "description": "Absolute points change."
          },
          "pct_change": {
            "type": "number",
            "title": "Pct Change",
            "description": "Percentage change."
